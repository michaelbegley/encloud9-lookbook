        {
          "slug": "b6",
          "name": "Blue 6",
          "color": "#6F8FCB"
        },
        {
          "slug": "b7",
          "name": "Blue 7",
          "color": "#9DB3DC"
        },
        {
          "slug": "b8",
          "name": "Blue 8",
          "color": "#C9D6EE"
        },
        {
          "slug": "b9",
          "name": "Blue 9",
          "color": "#EAF0F9"
        }
