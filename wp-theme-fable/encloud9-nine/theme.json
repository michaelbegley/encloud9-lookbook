      "defaultDuotone": false,
      "duotone": [],
      "text": true,
      "background": true,
      "link": false
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fluid": false,
      "fontFamilies": [
        {
          "fontFamily": "'Hanken Grotesk', Arial, sans-serif",
          "slug": "hanken",
          "name": "Hanken Grotesk",
          "fontFace": [
            {
              "fontFamily": "Hanken Grotesk",
              "fontWeight": "300",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-latin-300-normal.woff2"
              ]
            },
            {
              "fontFamily": "Hanken Grotesk",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-latin-400-normal.woff2"
              ]
            },
            {
              "fontFamily": "Hanken Grotesk",
              "fontWeight": "500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-latin-500-normal.woff2"
              ]
            },
            {
              "fontFamily": "Hanken Grotesk",
              "fontWeight": "600",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-latin-600-normal.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "15px"
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "17px"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "18px"
        }
      ],
      "fontStyle": false,
      "fontWeight": false,
      "letterSpacing": false,
      "lineHeight": false,
      "textDecoration": false,
      "textTransform": false,
      "writingMode": false
    },
    "spacing": {
      "customSpacingSize": false,
      "units": [
        "px",
        "%",
        "vw"
      ],
      "blockGap": null,
      "margin": false,
      "padding": false,
      "spacingSizes": [],
      "defaultSpacingSizes": false
    },
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    },
    "shadow": {
      "defaultPresets": false,
      "presets": []
    },
    "useRootPaddingAwareAlignments": false,
    "lightbox": {
      "enabled": false,
      "allowEditing": false
    }
  },
  "styles": {
    "color": {
      "background": "#F7F9FC",
      "text": "#0E1A3A"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|hanken",
      "fontSize": "17px",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "header-minimal",
      "title": "Header without the menu (ad landing page)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-minimal",
      "title": "Landing page without the menu",
      "postTypes": [
        "page"
      ]
    }
  ]
}