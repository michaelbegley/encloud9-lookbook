          "name": "Background",
          "color": "#F7F9FC"
        },
        {
          "slug": "tint",
          "name": "Tint",
          "color": "#EAF0F9"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        },
        {
          "slug": "b1",
          "name": "Blue 1",
          "color": "#0E1A3A"
        },
        {
          "slug": "b2",
          "name": "Blue 2",
          "color": "#172A5E"
        },
        {
          "slug": "b3",
          "name": "Blue 3",
          "color": "#1F3A80"
        },
        {
          "slug": "b4",
          "name": "Blue 4",
          "color": "#2A4B94"
        },
        {
          "slug": "b5",
